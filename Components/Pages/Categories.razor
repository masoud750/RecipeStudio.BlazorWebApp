@page "/Categories"
@rendermode InteractiveServer
@using RecipeStudio.Application.Interfaces
@using RecipeStudio.Shared.DTOs
@using RecipeStudio.Shared.Enums
@using RecipeStudio.Shared.DTOs.Commands
@using RecipeStudioBlazorApp.Server.Components.UI_Components
@using MudBlazor;
@inject ICategoryService _categoryService
@inject IDialogService DialogService
<PageTitle>Categories</PageTitle>
<h1>Categories</h1>



<div id="container">

   
    <!-- NEW: row 2, column 1 -->
    <div id="FirstComponent">
        @if (_categories != null && _categories.Count != 0)
        {
            <table class="table">
                <thead>
                    <tr>
                        <td><b>No</b></td>
                        <td><b>Categories</b></td>
                        <td>
                            <button @onclick="() => ExecuteAction(MenuItems[0])" class="btn btn-primary">+</button>

                        </td>
                    </tr>
                </thead>
                <tbody>
                    @{
                        _index = 0;
                    }
                    @foreach (var category in _categories!)
                    {
                        _index++;
                        <tr>
                            <td>@_index</td>
                            <td @oncontextmenu:preventDefault="true"
                                @oncontextmenu:stopPropagation="true"
                                @oncontextmenu="(e => ShowContextMenu(category, e))">
                                @category.Name
                            </td>
                            <td />

                           
                        </tr>
                    }
                </tbody>
            </table>

           
            
        }

    </div>

   
    <div id="SecondLayout"></div>
</div>

<ContextMenu MenuItems="MenuItems"
             Visible="IsMenuVisible"
             X="MenuXpx"
             Y="MenuYpx"
             CurrentItem="CurrentItem"
             OnAction="ExecuteAction" />

<AddDialog @ref="_addDialog"
           OnAdd="AddCategory"
           OnClose="CloseAddDialog"
           Title=@Title />
<EditDialog @ref="_editDialog"
            OnUpdateItem="UpdateCategory"
            OnClose="CloseEditDialog"
            Title=@Title
            Name=@CurrentItem?.Name />
<MessageDialog @ref="_msgDialog"></MessageDialog>



@code {

    private List<ItemDTO>? _categories;
    private int _index;
    private Dictionary<string, Func<object, Task>>? MenuActions;
    private AddDialog? _addDialog;
    private EditDialog? _editDialog;
    private MessageDialog? _msgDialog;
    private MudMessageBox _mudMessageBox;
    private List<string> MenuItems = new() { "Add", "Delete", "Edit" };
    public string Title { get; set; } = string.Empty;
    private bool Visible { get; set; }
    protected override async Task OnInitializedAsync()
    {
        MenuActions = new()
                {
                    { "Delete", async (s) =>
                        {
                            if (s != null && s is DeleteCategoryCommand cmd )
                            {
                                await _categoryService.DeleteAsync(cmd);

                                    _categories?.Remove(new ItemDTO(cmd.id,cmd.Name,ItemType.Category));

                            }
                        }
                    },
                    { "Add", async (s) =>
                        {
                           Title = "Add Category";
                           await _addDialog?.ShowDialog()!;
                        }
                    },
                    { "Edit", async (s) =>
                        {
                           Title = "Edit Category";
                           await _editDialog?.ShowDialog()!;
                        }
                    }
                };
        _categories = await _categoryService.GetAllAsync();
        await base.OnInitializedAsync();
    }

    private async Task ExecuteAction(string key)
    {
        ArgumentNullException.ThrowIfNullOrEmpty(key, nameof(key));
        await MenuActions[key].Invoke(CurrentItem);
        IsMenuVisible = false;
    }

    public void ShowContextMenu(ItemDTO? item, MouseEventArgs args)
    {
        if (item == null)
            return;
        CurrentItem = item;
        MenuXpx = (int)args.PageX;
        MenuYpx = (int)args.PageY;
        IsMenuVisible = true;
    }

    private bool IsMenuVisible;
    private int MenuXpx = 0;
    private int MenuYpx = 0;
    public ItemDTO? CurrentItem;


    private void Delete(ItemDTO currentItem)
    {
        Console.WriteLine("ttt");
        IsMenuVisible = false;
    }


    private async Task CloseAddDialog()
    {
        await _addDialog?.CloseDialog()!;

    }

    private async Task AddCategory(AddCategoryCommand item)
    {

        ArgumentNullException.ThrowIfNull(item, nameof(item));
        OperationResult result = await _categoryService.AddAsync(item);
        if (_msgDialog is not null)
        {
            switch (result)
            {
                case OperationResult.Success:
                    await _msgDialog.ShowDialog(
                        "Add Category",
                        $"Category '{item.Name}' was inserted successfully.",
                        result);
                    break;

                case OperationResult.AlreadyExists:
                    await _msgDialog.ShowDialog(
                        "Warning",
                        $"Category '{item.Name}' already exists.",
                        result);
                    break;

                case OperationResult.Error:
                    await _msgDialog.ShowDialog(
                        "Error",
                        $"An error occurred while adding category '{item.Name}'.",
                        result);
                    break;
            }
        }

    }

 

    private void OpenAddDialog()
    {

    }




    private async Task CloseEditDialog()
    {
        await _editDialog?.CloseDialog()!;
    }

    private void UpdateCategory(string name)
    {
        throw new NotImplementedException();
    }

   
}
