@page "/Recipes"
@using Domain.Entities
@using RecipeStudioBlazorApp.Server.Components.UI_Components
@using RecipeStudio.Shared.DTOs
@using RecipeStudio.Application.Services
@using RecipeStudio.Application.Interfaces
@inject IRecipeService RecipeSerivce

<PageTitle>Recipes</PageTitle>
<h1>Recips</h1>
<div>
    <table class="table">
        <thead>
            <tr>
                <td><b>No</b></td>
                <td><b>Name</b></td>
                <td><b>Author</b></td>
                <td><b>Categories</b></td>
                <td><b>Description</b></td>
                <td><b>Steps</b></td>
                <td><b>Ingredients</b></td>
            </tr>
        </thead>
        <tbody>
            @{
                _index = 0;
            }
            @foreach (RecipeDTO recipe in _recipes!)
            {
                _index++;
                <tr>
                    <td>@_index</td>
                    <td>@recipe.Name</td>
                    <td>@recipe.UserName</td>
                    <td>
                        <table>

                            @foreach (var c in recipe.Categories)
                            {
                                <tr>
                                    <td>@c.Name</td>
                                </tr>
                            }

                        </table>
                    </td>
                    <td>@recipe.Description</td>
                    <td>
                        <table>

                            @foreach (var s in recipe.Steps)
                            {
                                <tr>
                                    <td>@s.Name</td>
                                </tr>
                            }
                        </table>
                    </td>
                    <td>
                        <table>
                            @foreach (var i in recipe.Ingredients)
                            {
                                <tr>
                                    <td>@i.Name - @i.Quantity</td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
@code {

    List<RecipeDTO> _recipes = new();    
    private int _index;

    protected override async Task OnInitializedAsync()
    {
        _recipes = await RecipeSerivce.GetAllAsync();

    }
}
