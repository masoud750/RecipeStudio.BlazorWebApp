@page "/Recipes"
@using Domain.Entities
@using RecipeStudioBlazorApp.Server.Components.UI_Components
<PageTitle>Recipes</PageTitle>
<h1>Recips</h1>
<div>
    <table class="table">
        <thead>
            <tr>
                <td><b>No</b></td>
                <td><b>Name</b></td>
                <td><b>Author</b></td>
                <td><b>Category</b></td>
                <td><b>Description</b></td>
                <td><b>Step</b></td>
                <td><b>Ingredients</b></td>
            </tr>
        </thead>
        <tbody>
            @{
                _index = 0;
            }
            @foreach (Recipe recipe in _recipes!)
            {
                _index++;
                <tr>
                    <td>@_index</td>
                    <td>@recipe.Name</td>
                    <td>@recipe.User.UserName</td>
                    <td>
                        <table>

                            @foreach (var c in recipe.Categories ?? Enumerable.Empty<Category>())
                            {
                                <tr>
                                    <td>@c.Name</td>
                                </tr>
                            }

                        </table>
                    </td>
                    <td>@recipe.Description</td>
                    <td>
                        <table>

                            @foreach (var s in recipe.Steps ?? Enumerable.Empty<Step>())
                            {
                                <tr>
                                    <td>@s.Name</td>
                                </tr>
                            }
                        </table>
                    </td>
                    <td>
                        <table>
                            @foreach (var i in recipe.Ingredients ?? Enumerable.Empty<Ingredient>())
                            {
                                <tr>
                                    <td>@i.Name - @i.Quantity</td>
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
        </tbody>

    </table>
</div>
