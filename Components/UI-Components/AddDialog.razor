@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

 <dialog @ref="_dialog" class="body-dialog">
    <div @ref="_caption" class="dialog-header">        
            @Title        
        <button @onclick="Close">X</button>
    </div>

    <div class="dialog-body">
        <label>Name:</label>
        <input type="text" />
    </div>

    <div class="dialog-footer">
        <button @onclick="Close" class="close-btn">Close</button>
        <button @onclick="AddItem" class="add-btn">Add</button>
    </div>
</dialog>
 


@code{

    private ElementReference _dialog;
    private ElementReference _caption;
    private ElementReference _nameInput;

    private void Close()
    {
        OnClose.InvokeAsync();
    }
    [Parameter]
    public EventCallback OnClose
    {
        get; set;
    }


    public void AddItem()
    {
        OnAdd.InvokeAsync(_nameInput.ToString());
    }

    [Parameter]
    public EventCallback<string> OnAdd
    {
        get; set;
    }




    [Parameter] public bool Visible { get; set; }




    public async Task ShowDialog()
    {
        JSModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import",
            "/JS/shared-dialog.js");
        if (JSModule == null)
            return;
        await JSModule.InvokeVoidAsync("showDialog", _dialog);
        Visible = true;
    }
    IJSObjectReference? JSModule;

    public async Task CloseDialog()
    {
        JSModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import",
            "/JS/shared-dialog.js");
        if (JSModule == null)
            return;
        await JSModule.InvokeVoidAsync("closeDialog", _dialog);
        Visible = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
         
            JSModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                "/JS/shared-dialog.js");
            if (JSModule == null)
                return;
            await JSModule.InvokeVoidAsync("makeDraggable", _dialog, _caption); 
            
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;
    }