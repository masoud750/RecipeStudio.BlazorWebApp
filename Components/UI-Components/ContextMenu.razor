@using Domain.Entities

@if (Visible)
{
    <div class="context-menu" style="top:@($"{Y - 3}px"); left:@($"{X}px");">
        <ul>
            @foreach (var entry in MenuItems)
            {
                <li @onclick="async () => await OnAction.InvokeAsync(entry)">
                    @entry
                </li>
            }
        </ul>
    </div>
}
@code{
    [Parameter] public List<string> MenuItems { get; set; } = new();
    [Parameter] public bool Visible { get; set; }
    [Parameter] public int X { get; set; }
    [Parameter] public int Y { get; set; }
    [Parameter] public EntityBase? CurrentItem { get; set; }

    [Parameter] public EventCallback<string> OnAction { get; set; }
}